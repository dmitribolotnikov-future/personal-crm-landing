---
import Avatar from "./Avatar.astro";
import AvatarStack from "./AvatarStack.astro";
import Button from "./Button.astro";

// Sizes here include padding and borders: the mockup sets width without them,
// e.g. a 250px card with 16px padding is w-70.5 (282px)
---

<section
  class="flex flex-1 flex-col md:grid md:grid-cols-[repeat(auto-fit,minmax(min(100%,--spacing(115)),1fr))] md:items-center md:gap-14 md:pt-10 md:pb-24"
>
  <div class="flex flex-col gap-4.5 px-5 pt-9 md:gap-7 md:p-0">
    <div class="flex items-center gap-2.5 md:gap-3">
      <AvatarStack
        avatarClass="size-8 border-2 border-bg text-11 md:size-9.5 md:text-12"
        overlapClass="-ml-2 md:-ml-2.5"
        avatars={[
          { initials: "СК", class: "bg-accent text-white" },
          { initials: "ДМ", class: "bg-ink text-white" },
          { initials: "АП", class: "bg-powder text-accent-deep" },
        ]}
      />
      <span class="text-15 font-medium text-ink-soft md:text-17">Личная CRM для ваших контактов</span>
    </div>
    <h1
      class="text-42 leading-display font-bold tracking-tight-45 text-balance md:text-h1 md:leading-none md:tracking-tight-50"
    >
      Не теряйте связь с теми, кого знаете <span class="text-accent">лично</span>
    </h1>
    <p class="text-17 leading-lead text-pretty text-ink-soft md:max-w-130 md:text-20 md:leading-body">
      Храните все контакты в одном месте и записывайте важное о каждом человеке, чтобы ничего не терялось
    </p>
    <Button class="self-start px-7 py-4.5 text-17 md:px-8 md:py-5 md:text-18" />
  </div>

  <div
    aria-hidden="true"
    class="relative mx-5 mt-7.5 flex-1 overflow-hidden rounded-t-28 bg-powder md:m-0 md:h-140 md:rounded-40"
  >
    <div
      class="absolute top-6.5 left-5.5 flex w-70.5 -rotate-5 flex-col gap-2.5 rounded-20 bg-white p-4 shadow-card md:top-16 md:left-[8%] md:w-90 md:gap-3 md:rounded-24 md:p-5 md:shadow-card-lg"
    >
      <div class="flex items-center gap-2.5 md:gap-3">
        <Avatar class="size-10 bg-accent text-15 text-white md:size-12 md:text-17">СК</Avatar>
        <div>
          <div class="text-15 font-bold md:text-17">Саша Ковалёва</div>
          <div class="text-12 text-muted md:text-14">Продакт в финтехе</div>
        </div>
      </div>
      <div
        class="rounded-12 bg-gray-2 p-2.5 text-13 leading-snug text-ink-soft md:rounded-14 md:p-3 md:text-15 md:leading-lead"
      >
        Познакомились на конференции. Познакомил Дима.
      </div>
    </div>

    <div
      class="absolute top-37.5 right-4.5 flex w-60.5 rotate-4 flex-col gap-1.5 rounded-20 bg-ink p-4 text-white md:top-65 md:right-[8%] md:w-80 md:gap-2 md:rounded-24 md:p-5"
    >
      <div class="font-mono text-11 font-medium tracking-wide-60 text-accent-soft md:text-12">ЗАМЕТКА · 12 МАРТА</div>
      <div class="text-14 leading-snug font-medium md:text-17">Переезжает в Тбилиси в мае, ищет школу для сына</div>
    </div>

    <div
      class="absolute bottom-12 left-[14%] hidden w-72 -rotate-2 items-center gap-2.5 rounded-pill bg-white py-2.5 pr-4.5 pl-2.5 shadow-pill md:flex"
    >
      <Avatar class="size-9 bg-ink text-12 text-white">АМ</Avatar>
      <div>
        <div class="text-14 font-semibold">Аня Морозова</div>
        <div class="text-12 text-muted">Юрист · подруга Лены</div>
      </div>
    </div>
  </div>
</section>
